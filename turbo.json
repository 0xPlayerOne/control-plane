{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "openapi:check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_ADMIN_URL",
        "DATABASE_MIGRATION_URL",
        "DATABASE_URL",
        "RUN_DATABASE_INTEGRATION"
      ]
    }
  }
}
