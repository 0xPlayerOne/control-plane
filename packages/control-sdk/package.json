{
  "name": "@control-plane/sdk",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "browser": false,
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "node": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "openapi:check": "bun scripts/openapi.mjs --check",
    "openapi:generate": "bun scripts/openapi.mjs --write",
    "openapi:initialize-baseline": "bun scripts/openapi.mjs --initialize-baseline",
    "test": "bun test src/*.test.mjs"
  },
  "dependencies": {
    "@control-plane/contracts": "workspace:^"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "zod": "4.5.4"
  }
}
