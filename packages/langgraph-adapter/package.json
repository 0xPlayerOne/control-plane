  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "bun test src/*.test.mjs",
    "test:integration": "bun test --timeout 30000 src/*.integration.test.mjs"
  },
  "dependencies": {
    "@control-plane/orchestration": "workspace:*",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "zod": "4.4.3"
  }
}
