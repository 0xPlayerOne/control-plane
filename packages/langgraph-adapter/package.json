{
  "name": "@control-plane/langgraph-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "browser": false,
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
