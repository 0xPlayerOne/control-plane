# Pin this to a published immutable image tag for upgrades and rollbacks.
CONTROL_PLANE_IMAGE=control-plane/local-control-plane:local
CONTROL_PLANE_VERSION=0.0.0-self-hosted
CONTROL_PLANE_COMMIT_SHA=self-hosted
CONTROL_PLANE_INSTANCE_ID=hosted-simple

# Loopback is the safe default. Put a TLS reverse proxy on the same host.
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_PORT=3000

# This directory is owned and backed up by the operator.
CONTROL_PLANE_DATA_PATH=./data/simple

CONTROL_PLANE_CPU_LIMIT=2.0
CONTROL_PLANE_MEMORY_LIMIT=2G
CONTROL_PLANE_CPU_RESERVATION=0.25
CONTROL_PLANE_MEMORY_RESERVATION=256M

# Server profile. Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=
CONTROL_PLANE_SERVER_IMAGE=control-plane/hosted-control-plane:local
CONTROL_PLANE_SERVER_DATA_PATH=./data/server/control-plane
POSTGRES_DATA_PATH=./data/server/postgres
RESTATE_DATA_PATH=./data/server/restate
CONTROL_PLANE_SERVER_CPU_LIMIT=2.0
CONTROL_PLANE_SERVER_MEMORY_LIMIT=2G
