{
  "schemaVersion": 1,
  "provider": "railway",
  "profiles": {
    "cloud": {
      "environment": "managed-cloud",
      "services": [
        {
          "name": "control-api",
          "app": "control-api",
          "buildCommand": "bun run build --filter=@control-plane/control-api...",
          "public": true,
          "healthPath": "/health",
          "readyPath": "/ready",
          "requires": [
            "DATABASE_URL",
            "CONTROL_PLANE_SECRET_ENCRYPTION_KEY",
            "CONTROL_PLANE_SERVICE_AUTH_TOKEN",
            "R2_ENDPOINT",
            "R2_BUCKET",
            "R2_REGION",
            "R2_ACCESS_KEY_ID",
            "R2_SECRET_ACCESS_KEY",
            "RESTATE_INGRESS_URL"
          ]
        },
        {
          "name": "workflow-worker",
          "app": "workflow-worker",
          "buildCommand": "bun run build --filter=@control-plane/workflow-worker...",
          "public": false,
          "healthPath": "/health",
          "readyPath": "/ready",
          "requires": [
            "DATABASE_URL",
            "CONTROL_PLANE_SECRET_ENCRYPTION_KEY",
            "CONTROL_PLANE_SERVICE_AUTH_TOKEN",
            "RESTATE_REQUEST_IDENTITY_PUBLIC_KEY",
            "R2_ENDPOINT",
            "R2_BUCKET",
            "R2_REGION",
            "R2_ACCESS_KEY_ID",
            "R2_SECRET_ACCESS_KEY"
          ]
        }
      ],
      "migration": {
        "app": "database",
        "command": "bun --cwd=packages/database run db:migrate",
        "requires": ["DATABASE_MIGRATION_URL"]
      }
    }
  }
}
