{
  "name": "@control-plane/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.14 <2"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint eslint.config.js tests && bun run check:boundaries",
    "openapi:check": "turbo run openapi:check",
    "test": "bun run test:unit",
    "test:unit": "turbo run test && bun test tests",
    "test:integration": "bun scripts/run-integration-tests.mjs",
    "test:foundation": "bun run test:unit && bun run test:integration",
    "test:coverage": "turbo run test -- --coverage",
    "test:shard": "turbo run test --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "turbo boundaries",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.0.1",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
