{
  "name": "@control-plane/workspace",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.14 <2"
  },
  "scripts": {
    "build": "turbo run build",
    "type-check": "turbo run build openapi:check && bun run db:check",
    "lint": "turbo run lint && eslint eslint.config.js tests && bun run check:boundaries",
    "openapi:check": "turbo run openapi:check",
    "test": "bun run build && bun run --parallel 'test:group:*'",
    "test:group:unit": "bun scripts/run-bun-test-group.mjs unit --coverage",
    "test:group:e2e": "bun scripts/run-bun-test-group.mjs e2e",
    "test:group:smoke": "bun scripts/run-bun-test-group.mjs smoke",
    "test:unit": "bun run build && bun scripts/run-bun-test-group.mjs unit --coverage",
    "test:integration": "bun scripts/run-integration-tests.mjs",
    "test:e2e": "bun run build && bun scripts/run-bun-test-group.mjs e2e",
    "test:smoke": "bun run build && bun scripts/run-bun-test-group.mjs smoke",
    "test:foundation": "bun run test && bun run test:integration",
    "test:acceptance": "bun scripts/run-foundation-acceptance.mjs",
    "test:m3-acceptance": "bun test tests/m3-durable-execution.test.mjs",
    "test:m4-acceptance": "bun --cwd=apps/control-api run build && bun test tests/m4-runtime-fabric.test.mjs",
    "test:coverage": "bun run test:unit",
    "test:shard": "bun run build && bun scripts/run-bun-test-group.mjs unit",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path infrastructure/terraform/.gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path infrastructure/terraform/.gitignore",
    "check:boundaries": "turbo boundaries",
    "containers:build": "docker buildx bake -f infrastructure/containers/docker-bake.hcl",
    "containers:print": "docker buildx bake -f infrastructure/containers/docker-bake.hcl --print",
    "infra:fmt:check": "bun scripts/validate-terraform.mjs --format-only",
    "infra:validate": "bun scripts/validate-terraform.mjs",
    "db:check": "bun --cwd=packages/database run db:check",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres"
  },
  "devDependencies": {
    "@control-plane/context": "workspace:*",
    "@control-plane/contracts": "workspace:*",
    "@control-plane/domain": "workspace:*",
    "@control-plane/events": "workspace:*",
    "@control-plane/execution-plan": "workspace:*",
    "@control-plane/runtime-sdk": "workspace:*",
    "@control-plane/sdk": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
